# Include from the app's own CMake after adding its target. Verification JSON is
# emitted by native/tools/build_audio_decoder.py for the exact selected NDK.
function(hades_link_audio_decoder target verification)
  # NDK's legacy toolchain reports CMAKE_SYSTEM_VERSION=1; its actual API is
  # ANDROID_PLATFORM_LEVEL and the compiler triple contains the same level.
  set(audio_app_api "${ANDROID_PLATFORM_LEVEL}")
  if(NOT audio_app_api)
    set(audio_app_api "${CMAKE_SYSTEM_VERSION}")
  endif()
  if(NOT ANDROID OR audio_app_api VERSION_LESS 26)
    message(FATAL_ERROR "Hades audio output requires Android API26 or newer")
  endif()
  file(READ "${verification}" audio_proof)
  string(JSON schema GET "${audio_proof}" schema)
  string(JSON abi GET "${audio_proof}" abi)
  string(JSON api GET "${audio_proof}" api)
  string(JSON ndk GET "${audio_proof}" ndk)
  string(JSON source GET "${audio_proof}" source_root)
  if(NOT schema STREQUAL "hades-audio-decoder-build-v1" OR NOT abi STREQUAL ANDROID_ABI OR NOT api EQUAL 26)
    message(FATAL_ERROR "Audio dependency verification does not match Android arm64/API26")
  endif()
  set(audio_app_ndk "${CMAKE_ANDROID_NDK}")
  if(NOT audio_app_ndk)
    set(audio_app_ndk "${ANDROID_NDK}")
  endif()
  file(REAL_PATH "${audio_app_ndk}" selected_ndk)
  if(NOT selected_ndk STREQUAL ndk)
    message(FATAL_ERROR "Audio dependencies were built with a different NDK")
  endif()
  foreach(name IN ITEMS vgmstream vorbisfile vorbis ogg)
    string(JSON library GET "${audio_proof}" libraries ${name} path)
    string(JSON expected GET "${audio_proof}" libraries ${name} sha256)
    file(SHA256 "${library}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Audio dependency hash mismatch: ${name}")
    endif()
    target_link_libraries(${target} PRIVATE "${library}")
  endforeach()
  target_include_directories(${target} PRIVATE "${source}/src")
  target_link_libraries(${target} PRIVATE aaudio m)
endfunction()
