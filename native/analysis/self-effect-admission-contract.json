{
  "schema": "hades-native-self-effect-admission-v1",
  "status": "bounded original static/REA evidence; portable admission and argument construction implemented, native side effects remain parent callbacks",
  "observations": {
    "weapon_self_path": {
      "function": "Weapon::ApplySelfEffects RVA0x86930",
      "order": [
        "Always stream0 RandomDouble once for WeaponData.EffectsProcChance, including empty vector; equality passes",
        "Capture begin/end vector of 0x418-byte EffectData records",
        "Each item: Active && Trigger match, then stream0 RandomDouble <= ProcChance, then RequirePerfectCharge query",
        "UnitStatus::GetEffect exact name lookup",
        "New: EffectFactory(data,weapon,0), SelfApplied=true, virtual AffectUnit(actual status owner) synchronously, append to pending only after return",
        "Existing: virtual Reapply(data,weapon,&float(-1)), preserving existing SelfApplied"
      ],
      "bypasses": "UnitStatus::AddEffect owner liveness/immunity/block/duration admission gates; do not import them into self effects"
    },
    "general_add_effect": {
      "rva": "0x2fdca0",
      "gates": [
        "owner exists/alive",
        "!status.BlockAllEffects and !UnitData.BlockAllEffects",
        "incoming data mId differs from blocked EffectId",
        "Duration > 0",
        "Charm/Stun/Slow/DoT immunity conditions",
        "DelayedKnockback requires positive source projectile impact velocity when valid projectile",
        "Exact effect-name immunity list"
      ],
      "not_implemented_by_self_effect_module": true
    },
    "factory": {
      "rva": "0x5e200",
      "mapping": {
        "0": "SpeedEffect",
        "4": "DamageOverTimeEffect",
        "5": "DamageOverDistanceEffect",
        "6": "DelayedKnockbackEffect",
        "7": "CharmEffect",
        "8": "WeaponFireEffect",
        "9": "ProjectileDefenseEffect",
        "11": "InvulnerableEffect",
        "default including UNKNOWN12": "TagEffect"
      }
    },
    "base_affect_unit": {
      "rva": "0x5cb40",
      "sequence": [
        "Set UnitId actual owner and TimeRemaining from EffectData.Duration",
        "HaltOnStart physics; DestroyProjectileOnStart selection and mark; EnableWeaponForDuration flag",
        "Apply elapsed multiplier to unit and attached animation",
        "ScriptManager::OnEffectApply(effect,unit,false) callback barrier",
        "Flash/StartAnimation/StartFx; persistent overhead FX(+70,data+f8), back(+78,data+110), front(+40,data+128), in that order with one outer cleared check",
        "Scale front/back FX to actual source projectile radius; capture original UnitProperty then actual Unit.SetUnitProperty Absolute",
        "DisableAttack and !ImmuneToStun -> actual Unit::OnStun(Duration)",
        "Play actual SoundCue and retain sound handle"
      ],
      "caution": "Callback occurs before remaining effects, before pending publication, and can mutate source data or clear effect. Full side effects are not replaced by status flags."
    },
    "tag_affect_unit": {
      "factory_rva": "0x60f00",
      "affect_rva": "0x61100",
      "observations": [
        "Runs full base Effect::AffectUnit",
        "Cooldown copied to TagEffect+0x8c; Rate >0 sets periodic state",
        "Cooldown ==0 sets active tick flag; otherwise add Cooldown to TimeRemaining"
      ]
    },
    "apply_callback": {
      "rva": "0x28dc70",
      "filter": "Loop real OnEffectApply registrations, Script::isSourceThing(owner), fresh args for each",
      "fields": {
        "EffectType": "actual enum ToString; unknown/out of range -> UNKNOWN",
        "EffectName": "actual EffectData.Name",
        "Reapplied": "passed native bool",
        "Stacks": "Effect.NumStacks +1 (int32)",
        "Modifier": "EffectData.Modifier float",
        "Duration": "EffectData.Duration float, not override remaining",
        "IsVulnerabilityEffect": "EffectData boolean",
        "ElapsedTimeMultiplier": "Effect.AppliedElapsedTimeMultiplier float",
        "UnitElapsedTimeMultiplier": "current actual owner elapsed multiplier",
        "name": "owner virtual name/common Script::run",
        "triggeredById": "actual owner runtime ID",
        "TriggeredByTable": "actual owner attached alias or absent/nil"
      },
      "absent_fields": [
        "SourceWeapon",
        "AttackerTable",
        "BlockedEffect",
        "Exists"
      ],
      "owner_alias": "Affected unit, not source weapon owner",
      "native_source": "Combat.lua3462 original unfiltered registration retains same fresh table"
    },
    "lookup": {
      "rva": "0x2fdf60",
      "order": [
        "toDelete exact matching name -> null immediately",
        "First exact active match",
        "First exact pending match"
      ],
      "flags": "No cleared/disposed filtering; native textual name comparison"
    },
    "empty_guards": {
      "Thing_SetAnimation": "Empty name returns null at1802ded10..1802ded13 before data lookup",
      "FX_attached_Create": "Empty name returns null at18029e385..18029e396 before data lookup",
      "FX_world_Create": "Empty or exact literal null returns null before data lookup (18029e45b and18029e4a2)",
      "Sound_Play3D": "Empty cue name branches180049d8d->180049e7f returns0",
      "Sound_Play2D": "Empty cue name branches180049cd5->180049d28 returns0"
    },
    "unit_on_stun": {
      "rva": "0x2f3b80",
      "gate": "Duration >0",
      "sequence": [
        "Thing::SetAnimation(UnitData.StunAnimation full1d8,false,true,false)",
        "Arsenal.GetWeapon(UnitData.StunWeapon full1c0)",
        "If found, Weapon.RequestFire(-1,zero vectors,true,null)"
      ],
      "no_status_timer_assignment_in_function": true
    },
    "postread_duration_frames": {
      "report": ".local/reports/native-weapon-effectnorm-effect-read-static.json",
      "addresses": "1800b297c..1800b2995",
      "formula": "if DurationFrames(int32)>0: Duration=float32(DurationFrames)/float32(60.0)",
      "constant": {
        "va": "0x180611054",
        "bytes": "00007042",
        "value": 60.0
      },
      "source_override": "This postread rewrites explicit source Duration when positive frames present"
    },
    "reapply": {
      "data_overload_rva": "0x5d910",
      "noarg_overload_rva": "0x5d350",
      "data_overload": [
        "Checks EXISTING data ExtendDurationOnReapply full144",
        "If true, timeRemaining reset to incoming Duration if incoming nonnull else existing Duration",
        "Tail calls virtual noarg Reapply slot28"
      ],
      "noarg": [
        "Owner active lookup by effect.UnitId; if absent return",
        "DisableAttack and !ImmuneToStun -> Unit::OnStun before callback",
        "Conditional elapsed-multiplier stack update",
        "OnEffectApply(reapplied=true)",
        "Actual ReapplyFx at current owner location"
      ],
      "limits": "Self admission calls virtual slot20 with data/weapon/duration; derived overrides and their duration/ref semantics must remain actual callbacks, not generic timer refresh"
    }
  },
