 "gamepad_hardware": {
  "source": "gainput::InputDevicePadImplWin::Update 0x180368780 (XInput XINPUT_GAMEPAD wButtons bit -> PadButton)",
  "buttons": {
   "bit0 DPAD_UP": 48,
   "bit1 DPAD_DOWN": 49,
   "bit2 DPAD_LEFT": 46,
   "bit3 DPAD_RIGHT": 47,
   "bit4 START": 44,
   "bit5 BACK": 45,
   "bit6 LEFT_THUMB": 58,
   "bit7 RIGHT_THUMB": 59,
   "bit8 LEFT_SHOULDER": 54,
   "bit9 RIGHT_SHOULDER": 55,
   "bit12 A": 50,
   "bit13 B": 51,
   "bit14 X": 52,
   "bit15 Y": 53,
   "bLeftTrigger != 0": 56,
   "bRightTrigger != 0": 57
  },
  "axes": {
   "sThumbLX": 0,
   "sThumbLY": 1,
   "sThumbRX": 2,
   "sThumbRY": 3,
   "bLeftTrigger/255": 4,
   "bRightTrigger/255": 5
  },
  "axis_sign": "XInput thumb Y is positive up; the engine consumes it unchanged (InputHandler::GetDirection adds +1 to y for Up).",
  "conclusion": "PadButtonA/B/X/Y are the Xbox face buttons by position name (A bottom, B right, X left, Y top). L2/R2 digital = any nonzero trigger byte."
 },
