  "value_change": {
    "enum": {
      "Absolute": 0,
      "Multiply": 1,
      "MultiplyBase": 2,
      "Add": 3,
      "ReplaceIfNull": 4
    },
    "parse": "native parser can be case-insensitive; unknown spelling falls back Absolute0",
    "float32": {
      "Absolute": "round source numeric to float32; missing any ->0",
      "Multiply": "float32(current*ConvertAnyToFloat(value))",
      "Add": "float32(current+ConvertAnyToFloat(value))",
      "ReplaceIfNull": "native returns false, unchanged"
    },
    "int32": {
      "Absolute": "source floating numeric truncated toward zero; missing ->0",
      "Multiply": "roundf(float32(current)*ConvertAnyToFloat(value)), ties away from zero",
      "Add": "current+ConvertAnyToInt(value), conversion truncates float/double toward zero",
      "ReplaceIfNull": "native returns false, unchanged"
    },
    "bool": "bool any or const-char*/string case-insensitive true/false; other strings become false; numeric/missing any unsupported unchanged",
    "string": "empty any clears string; existing text replaces it irrespective relative mode except MultiplyBase special path",
    "numeric_wrong_type_relative": "ConvertAnyToFloat/Int returns0 for nonnumeric/missing values",
    "MultiplyBase_weapon_numeric": "WeaponData mode resolves base Weapon by name, shared helper reflects NON-PROJECTILE base through generic GameData info ONLY(Name,Organization,InheritFrom). Numeric WeaponData property not found => empty delta => recursive Add0. Do not use source catalog numeric base!",
    "safety_boundary": "portable module rejects nonfinite/overflow and unrepresented complex types; native may assert or overflow"
  },
  "portable_api": {
    "method": "WeaponArsenal::setScriptProperty(weapon,property,optional<WeaponScalar>,WeaponValueChange,bool dataValue,string& error)",
    "old_api": "setProperty remains strict typed low-level setter",
    "supported_live_fields": [
      "Ammo",
      "Volley",
      "ClipShotsRemaining",
      "Charging",
      "ReloadPaused",
      "ChargeTimeRemaining",
      "CooldownTimeRemaining",
      "ReloadTimeRemaining",
      "NextClipRegenTime",
      "LastFireTime",
      "Scatter"
    ],
    "unsupported": [
      "complex fields",
      "weapon subtype mutation",
      "Projectile copy mutation",
      "unrepresented live fields",
      "live MultiplyBase category",
      "effect execution"
    ]
  },
  "ordering_limits": [
    "Native active-map selection uses pointer/hash containers; exact enumeration is not reconstructed. Parent must document its deterministic live selection order.",
    "No metadata query proxy qualifies as a native live unit.",
    "A getter stops on first qualifying weapon even if property lookup fails; do not continue to find another owner property."
  ],
  "checks": "focused actual-source ASAN/UBSAN harness covers per-instance changes, bool strings, literal-null asymmetry, integer absolute truncation/multiply roundf/add truncation, numeric MultiplyBase empty-base behavior, live writes and rejected-value rollback; no original binary execution."
