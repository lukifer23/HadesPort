        },
        "Property": {
          "default": ""
        },
        "ValueChangeType": {
          "default": "Absolute"
        },
        "DataValue": {
          "default": true
        },
        "Value": {
          "default": "empty eastl::any"
        }
      },
      "target": "World.GetActiveMapThings -> native Unit mask0x221 -> owned WeaponName; skip unmatched/missing targets",
      "data_true": "per-owned-weapon copied WeaponData; literal const-char* Value exactly null becomes empty any",
      "data_false": "live Weapon reflection; rereads original Value, so literal null is NOT normalized",
      "EffectName": "not read; belongs to separate SetEffectProperty",
      "side_effects": {
        "MaxAmmo": "sets current Ammo to modified MaxAmmo",
        "ClipSize": "sets current ClipShotsRemaining to modified ClipSize",
        "controls": "refreshes four control pointers, does not modify controllable-vector membership",
        "other_fields": "no automatic timer reset or PostRead/frame reprocessing"
      }
    },
